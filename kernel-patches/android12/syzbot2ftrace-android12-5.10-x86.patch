  */
+#include "asm/current.h"
+#include "security.h"
 #include <linux/types.h>
 #include <linux/stddef.h>
 #include <linux/kernel.h>
@@ -1200,6 +1202,27 @@ int avc_has_perm(struct selinux_state *state, u32 ssid, u32 tsid, u16 tclass,
 
 	rc2 = avc_audit(state, ssid, tsid, tclass, requested, &avd, rc,
 			auditdata, 0);
+
+	if (strcmp(current->comm, "repro") == 0) {
+		char *scontext, *tcontext;
+		u32 scontext_len, tcontext_len;
+
+		if (security_sid_to_context(state, ssid, &scontext, &scontext_len)) {
